# Copia este archivo a backend/.env y ajusta los valores:
#
#   cd backend && cp .env.example .env
#
# backend/.env contiene secretos y está excluido de git (.gitignore). No lo
# versiones, no lo pegues en Issues/PRs y no compartas sus valores por chat.
# Este archivo .env.example solo debe llevar valores de ejemplo.

# =============================================================================
# Desarrollo local — PostgreSQL 17 + pgvector administrado por npm run db:local
# =============================================================================

# development | test | production
# En production, la semilla (npm run seed) se bloquea y se exigen secretos más largos.
NODE_ENV=development

# Solo para QA interno: habilita GET /api/auth/demo y POST /api/auth/ingreso-demo.
# La interfaz ya NO usa esos endpoints; el acceso normal es correo y contraseña
# (o registro en /registro). En producción debe ser false. Si se omite, el valor
# por defecto es true fuera de producción y false en ella.
DEMO_MODE=true

# Opcional y solo para desarrollo: contraseña compartida que `npm run seed`
# asigna a las cuentas sembradas (tutoría, coordinación, asesoría y admón.).
# Si se omite, la semilla genera una aleatoria y la imprime una sola vez en la
# salida. No publiques el valor ni lo reutilices en producción.
# DEMO_PASSWORD=

# Base local en .local-pg (cluster del repo), puerto 54330, sin contraseña.
# La crea/levanta `npm run db:local`; no requiere Docker ni Supabase.
DATABASE_URL=postgresql://postgres@127.0.0.1:54330/apoyo_tutorial

# Firma la cookie de sesión HttpOnly. Mínimo 16 caracteres en desarrollo y 32
# en producción. Cámbiala por entorno. Sugerencia: openssl rand -base64 32
JWT_SECRET=cambia-esta-clave-de-al-menos-16-caracteres

# Origen(es) del frontend para CORS y para la cookie de sesión. Acepta una
# lista separada por comas. En desarrollo se aceptan automáticamente
# localhost:5173, 127.0.0.1:5173 e [::1]:5173.
FRONTEND_ORIGIN=http://localhost:5173

# Puerto de la API NestJS (el frontend hace proxy a este puerto).
# Si el 3000 está ocupado, cambia PORT y arranca Vite con
# `VITE_API_PORT=<mismo puerto> npm run dev` en frontend/.
PORT=3000

# Duración de la sesión en horas (1 a 72). Opcional; por defecto 8.
SESSION_HOURS=8

# true solo detrás de un proxy inverso que envía X-Forwarded-*.
# En producción se activa automáticamente. Opcional; por defecto false.
TRUST_PROXY=false

# =============================================================================
# Supabase (opcional) — alternativa administrada al PostgreSQL local
# =============================================================================
# Si usas Supabase, comenta el DATABASE_URL local de arriba y descomenta este.
# Usa el pooler en modo transacción (puerto 6543); la API no prepara sentencias.
# pgvector ya viene instalado en Supabase.
# DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres

# =============================================================================
# OpenRouter / RAG — opcional salvo que se use la consulta normativa
# =============================================================================
# Sin clave, GET /api/contexto marca el RAG como no configurado y la pantalla
# de consulta se muestra deshabilitada con el motivo (no como error crudo).
# `npm run ingest -- --dry-run` no necesita clave; la ingesta real sí, y tiene costo.
OPENROUTER_API_KEY=

# Modelo de chat usado para redactar la respuesta citada.
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat

# Modelo de embeddings usado por la ingesta. Debe devolver EMBEDDING_DIMENSIONES.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Debe coincidir con la dimensión declarada en la migración de pgvector.
EMBEDDING_DIMENSIONES=1536

# Umbral de similitud (0 a 1). Si el mejor fragmento queda por debajo,
# el asistente se abstiene en lugar de inventar una respuesta.
RAG_UMBRAL_SIMILITUD=0.32

# Fragmentos normativos recuperados por consulta (1 a 20). Opcional; por defecto 4.
RAG_TOP_K=4
