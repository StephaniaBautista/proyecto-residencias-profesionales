# Pooler de Supabase, modo transacción (puerto 6543). La API no prepara
# sentencias, así que este modo es compatible. No subas este archivo con claves.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres

# Al menos 16 caracteres. Cámbiala en cada entorno.
JWT_SECRET=cambia-esta-clave-de-al-menos-16

FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# OpenRouter. El modelo de chat puede ser DeepSeek o MiMo.
# Los embeddings van aparte: el modelo de chat no devuelve vectores.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONES=1536
RAG_UMBRAL_SIMILITUD=0.32
